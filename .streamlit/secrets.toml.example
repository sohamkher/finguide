# Local: copy this file to .streamlit/secrets.toml and fill it in (that file is git-ignored).
# Streamlit Community Cloud: paste these lines into App settings -> Secrets instead.
GROQ_API_KEY = "paste-your-groq-key-here"
GROQ_MODEL = "openai/gpt-oss-120b"

# Optional protection for a public demo that runs on your key:
# MAX_QUESTIONS_PER_SESSION = "25"
# MAX_QUESTION_CHARS = "600"
